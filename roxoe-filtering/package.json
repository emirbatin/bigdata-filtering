{
  "name": "roxoe-filtering",
  "version": "1.0.1",
  "description": "Veri filtreleme ve işleme",
  "main": "./out/main/index.js",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint . --ext .js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix",
    "dev": "NODE_ENV=development ELECTRON_RENDERER_URL=http://localhost:5173 electron-vite dev",
    "build": "NODE_ENV=production electron-vite build",
    "start": "NODE_ENV=production electron out/main/index.js",
    "postinstall": "electron-builder install-app-deps",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win --x64",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux",
    "dist": "electron-builder"
  },
  "build": {
    "asar": false,
    "appId": "com.roxoe.filtering",
    "productName": "Roxoe Filtering",
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      {
        "from": "out",
        "to": "app/out",
        "filter": [
          "**/*"
        ]
      },
      "node_modules/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "out",
        "to": "app/out",
        "filter": [
          "**/*"
        ]
      }
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "emirbatin",
        "repo": "bigdata-filtering",
        "private": true,
        "releaseType": "release"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "resources/icon.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "resources/icon.icns"
    },
    "linux": {
      "target": "AppImage",
      "icon": "resources/icon.png"
    },
    "electronVersion": "31.6.0"
  },
  "dependencies": {
    "@electron-toolkit/preload": "^3.0.1",
    "@electron-toolkit/utils": "^3.0.0",
    "ag-grid-community": "^32.2.2",
    "ag-grid-react": "^32.2.2",
    "axios": "^1.7.7",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "electron-updater": "^6.3.4",
    "exceljs": "^4.4.0",
    "file-saver": "^2.0.5",
    "framer-motion": "^11.5.4",
    "fuse.js": "^7.0.0",
    "install": "^0.13.0",
    "jszip": "^3.10.1",
    "jwt-decode": "^4.0.0",
    "lucide-react": "^0.436.0",
    "moment": "^2.30.1",
    "nodemailer": "^6.9.15",
    "npm": "^10.8.3",
    "react-router-dom": "^6.26.1",
    "react-tooltip": "^5.28.0",
    "socket.io-client": "^4.7.5",
    "tailwind-merge": "^2.5.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electron-toolkit/eslint-config": "^1.0.2",
    "@electron-toolkit/eslint-config-prettier": "^2.0.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.20",
    "electron": "^31.0.2",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.3",
    "postcss": "^8.4.41",
    "prettier": "^3.3.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.10",
    "vite": "^5.3.1"
  }
}
